{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/chrober/bliss-playlist-guidance-spi/schemas/guidance-addon-spi-v2.schema.json",
  "title": "Bliss playlist optimizer guidance addon SPI v2",
  "description": "JSONL message schema. Each line is one request or response object.",
  "oneOf": [
    { "$ref": "#/$defs/describe_or_close" },
    { "$ref": "#/$defs/prepare" },
    { "$ref": "#/$defs/score" },
    { "$ref": "#/$defs/manifest" },
    { "$ref": "#/$defs/prepared" },
    { "$ref": "#/$defs/scores" },
    { "$ref": "#/$defs/closed" },
    { "$ref": "#/$defs/error" }
  ],
  "$defs": {
    "describe_or_close": {
      "type": "object",
      "required": ["type", "spi_version"],
      "properties": {
        "type": { "enum": ["describe", "close"] },
        "spi_version": { "const": 2 }
      },
      "additionalProperties": false
    },
    "prepare": {
      "type": "object",
      "required": ["type", "spi_version", "job_id", "options", "artifacts", "resources", "anchors"],
      "properties": {
        "type": { "const": "prepare" },
        "spi_version": { "const": 2 },
        "job_id": { "type": "string", "minLength": 1 },
        "options": { "type": "object" },
        "artifacts": { "type": "array", "items": { "$ref": "#/$defs/artifact_descriptor" } },
        "resources": { "type": "array", "items": { "$ref": "#/$defs/resource_descriptor" } },
        "anchors": { "type": "array", "items": { "$ref": "#/$defs/anchor" } }
      },
      "additionalProperties": false
    },
    "score": {
      "type": "object",
      "required": ["type", "spi_version", "request_id", "context", "candidates"],
      "properties": {
        "type": { "const": "score" },
        "spi_version": { "const": 2 },
        "request_id": { "type": "string", "minLength": 1 },
        "context": { "$ref": "#/$defs/score_context" },
        "candidates": { "type": "array", "items": { "$ref": "#/$defs/candidate" } }
      },
      "additionalProperties": false
    },
    "artifact_descriptor": {
      "type": "object",
      "required": ["kind", "path", "sha256"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" }
      },
      "additionalProperties": false
    },
    "resource_descriptor": {
      "type": "object",
      "required": ["kind", "path", "access"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "access": { "const": "read_only" }
      },
      "additionalProperties": false
    },
    "candidate": {
      "type": "object",
      "required": ["candidate_id"],
      "properties": {
        "candidate_id": { "type": "string", "minLength": 1 },
        "lms_urlmd5": { "type": ["string", "null"], "minLength": 1 },
        "database_file": { "type": ["string", "null"] },
        "title": { "type": ["string", "null"] },
        "artist": { "type": ["string", "null"] },
        "album": { "type": ["string", "null"] },
        "recording_mbid": { "type": ["string", "null"] },
        "artist_mbids": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "anchor": {
      "type": "object",
      "required": ["anchor_id", "candidate_id"],
      "properties": {
        "anchor_id": { "type": "string", "minLength": 1 },
        "candidate_id": { "type": "string", "minLength": 1 },
        "lms_urlmd5": { "type": ["string", "null"], "minLength": 1 },
        "database_file": { "type": ["string", "null"] },
        "title": { "type": ["string", "null"] },
        "artist": { "type": ["string", "null"] },
        "album": { "type": ["string", "null"] },
        "recording_mbid": { "type": ["string", "null"] },
        "artist_mbids": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "score_context": {
      "type": "object",
      "required": ["scope"],
      "properties": {
        "scope": { "enum": ["global", "edge"] },
        "left_anchor_id": { "type": ["string", "null"] },
        "right_anchor_id": { "type": ["string", "null"] },
        "context_track_ids": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "manifest": {
      "type": "object",
      "required": ["type", "spi_version", "provider_id", "provider_version", "protocol", "capabilities", "channels"],
      "properties": {
        "type": { "const": "manifest" },
        "spi_version": { "const": 2 },
        "provider_id": { "type": "string", "minLength": 1 },
        "provider_version": { "type": "string", "minLength": 1 },
        "protocol": { "const": "bliss-playlist-optimizer-guidance-jsonl-v2" },
        "capabilities": { "type": "array", "items": { "enum": ["global_candidate_guidance", "edge_candidate_guidance"] } },
        "channels": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["channel", "scopes"],
            "properties": {
              "channel": { "type": "string", "minLength": 1 },
              "scopes": {
                "type": "array",
                "minItems": 1,
                "items": { "enum": ["global", "edge"] }
              }
            },
            "additionalProperties": false
          }
        },
        "required_context": { "type": "array", "items": { "type": "string" } },
        "configuration_schema": { "type": ["object", "null"] }
      },
      "additionalProperties": false
    },
    "prepared": {
      "type": "object",
      "required": ["type", "provider_id", "diagnostics"],
      "properties": {
        "type": { "const": "prepared" },
        "provider_id": { "type": "string", "minLength": 1 },
        "snapshot_id": { "type": ["string", "null"] },
        "diagnostics": { "$ref": "#/$defs/diagnostics" }
      },
      "additionalProperties": false
    },
    "scores": {
      "type": "object",
      "required": ["type", "provider_id", "request_id", "signals", "diagnostics"],
      "properties": {
        "type": { "const": "scores" },
        "provider_id": { "type": "string", "minLength": 1 },
        "request_id": { "type": "string", "minLength": 1 },
        "signals": { "type": "array", "items": { "$ref": "#/$defs/guidance_signal" } },
        "diagnostics": { "$ref": "#/$defs/diagnostics" }
      },
      "additionalProperties": false
    },
    "guidance_signal": {
      "type": "object",
      "required": ["candidate_id", "channel", "scope", "score", "confidence"],
      "properties": {
        "candidate_id": { "type": "string", "minLength": 1 },
        "channel": { "type": "string", "minLength": 1 },
        "scope": { "enum": ["global", "edge"] },
        "score": { "type": "number", "minimum": -1, "maximum": 1 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "rationale": { "type": ["string", "null"] },
        "observed_at": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "diagnostics": {
      "type": "object",
      "properties": {
        "state": { "type": ["string", "null"] },
        "request_count": { "type": "integer", "minimum": 0 },
        "failure_count": { "type": "integer", "minimum": 0 },
        "details": {}
      },
      "additionalProperties": false
    },
    "closed": {
      "type": "object",
      "required": ["type", "provider_id"],
      "properties": {
        "type": { "const": "closed" },
        "provider_id": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "error": {
      "type": "object",
      "required": ["type", "provider_id", "code", "message", "retryable"],
      "properties": {
        "type": { "const": "error" },
        "provider_id": { "type": ["string", "null"] },
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 },
        "retryable": { "type": "boolean" }
      },
      "additionalProperties": false
    }
  }
}
